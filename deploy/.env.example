# Modèle à copier en .env puis à compléter (openssl rand -base64 32 pour JWT_SECRET).
APP_VERSION=1.0.0
DB_PASSWORD=change-me-db
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-s3-secret
JWT_SECRET=change-me-a-long-random-string-of-at-least-32-chars
BOOTSTRAP_ADMIN_EMAIL=admin@proclama.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
ENABLE_DEBUG=false
RATE_LIMIT_PER_MIN=30
PROXY_CONF=default.conf
POSTGRES_IMAGE=postgres:17-alpine
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine
S3_IMAGE=chrislusf/seaweedfs:3.80
